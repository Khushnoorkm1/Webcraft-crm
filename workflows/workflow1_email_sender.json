{
  "name": "AI Email Sender",
  "description": "Workflow for sending emails using AI",
  "version": "1.0.0",
  "triggers": [
    {
      "type": "manual",
      "description": "Manually trigger email sending"
    }
  ],
  "actions": [
    {
      "id": "generate_email",
      "type": "ai",
      "service": "openai",
      "description": "Generate email content using AI",
      "config": {
        "model": "gpt-4",
        "prompt": "Generate a professional email"
      }
    },
    {
      "id": "send_email",
      "type": "email",
      "service": "smtp",
      "description": "Send the generated email",
      "config": {
        "from": "noreply@webcraft-crm.com",
        "subject": "AI Generated Email"
      }
    }
  ],
  "status": "active"
}