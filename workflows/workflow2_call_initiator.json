{
  "id": "workflow_2_call_initiator",
  "name": "AI Call Initiator (Vapi)",
  "description": "Workflow to initiate AI-powered calls using Vapi integration",
  "version": "1.0.0",
  "triggers": [
    {
      "type": "manual",
      "name": "Initiate Call"
    },
    {
      "type": "webhook",
      "name": "Call Webhook"
    }
  ],
  "actions": [
    {
      "id": "action_1",
      "type": "vapi_call",
      "name": "Start Vapi Call",
      "config": {
        "phoneNumber": "",
        "systemPrompt": "",
        "model": "gpt-4"
      }
    },
    {
      "id": "action_2",
      "type": "log_result",
      "name": "Log Call Result"
    }
  ],
  "enabled": true
}